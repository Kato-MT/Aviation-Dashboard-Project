{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kato-mt.github.io/Aviation-Dashboard-Project/schemas/profile.v1.schema.json",
  "title": "Synthetic Detection Profile",
  "type": "object",
  "required": ["id", "version", "label", "synthetic", "dataClassification"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "label": { "type": "string", "minLength": 1 },
    "synthetic": { "const": true },
    "dataClassification": { "const": "SYNTHETIC_UNCLASSIFIED" },
    "disclaimer": { "type": "string", "minLength": 1 },
    "expectedCadenceMs": { "type": "number", "exclusiveMinimum": 0 },
    "requiredChannels": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "stableRuleIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$" }
    }
  },
  "additionalProperties": true
}
