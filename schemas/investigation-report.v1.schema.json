{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flight-diagnostics.local/schemas/investigation-report.v1.schema.json",
  "title": "Flight Diagnostics Workbench Investigation Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reportSchemaVersion",
    "generatedAt",
    "buildIdentities",
    "dataBoundary",
    "scenarioReproduction",
    "verificationOnlyLifecycle",
    "models",
    "results",
    "exportPolicy"
  ],
  "properties": {
    "reportSchemaVersion": { "const": "investigation-report.v1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "buildIdentities": { "$ref": "#/$defs/buildIdentities" },
    "dataBoundary": { "$ref": "#/$defs/dataBoundary" },
    "scenarioReproduction": { "$ref": "#/$defs/scenarioReproduction" },
    "verificationOnlyLifecycle": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/lifecycle" }]
    },
    "models": { "$ref": "#/$defs/models" },
    "results": { "$ref": "#/$defs/results" },
    "exportPolicy": { "$ref": "#/$defs/exportPolicy" }
  },
  "$defs": {
    "boundedText": { "type": "string", "minLength": 1, "maxLength": 256 },
    "sha256": {
      "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[0-9a-f]{64}$" }]
    },
    "count": { "type": "integer", "minimum": 0, "maximum": 2000000 },
    "sampleIndex": { "type": ["integer", "null"], "minimum": 0, "maximum": 1999 },
    "delayMs": { "type": ["integer", "null"], "minimum": 0, "maximum": 1999000 },
    "scenarioId": {
      "enum": [
        "nominal",
        "gradual-drift",
        "noise-growth",
        "oscillation",
        "lag",
        "intermittent-dropout",
        "stuck-value",
        "gain-error",
        "fuel-leak",
        "cross-sensor-decoupling",
        "simultaneous-faults"
      ]
    },
    "faultId": {
      "enum": [
        "gradual-drift",
        "noise-growth",
        "oscillation",
        "lag",
        "intermittent-dropout",
        "stuck-value",
        "gain-error",
        "fuel-leak",
        "cross-sensor-decoupling",
        "simultaneous-faults"
      ]
    },
    "buildIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicationVersion", "releaseSha", "releaseStatus", "buildTarget"],
      "properties": {
        "applicationVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
        "releaseSha": { "type": "string", "minLength": 1, "maxLength": 128 },
        "releaseStatus": { "enum": ["unreleased", "exact-release"] },
        "buildTarget": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "buildIdentities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reactShell", "deterministicEngine"],
      "properties": {
        "reactShell": { "$ref": "#/$defs/buildIdentity" },
        "deterministicEngine": {
          "type": "object",
          "additionalProperties": false,
          "required": ["applicationVersion", "authority"],
          "properties": {
            "applicationVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
            "authority": { "const": "deterministic-rules" }
          }
        }
      }
    },
    "dataBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "synthetic",
        "dataClassification",
        "generatorSchemaVersion",
        "generatorKind",
        "profile"
      ],
      "properties": {
        "synthetic": { "const": true },
        "dataClassification": { "const": "SYNTHETIC_UNCLASSIFIED" },
        "generatorSchemaVersion": { "const": "temporal-synthetic.v1" },
        "generatorKind": { "const": "bundled-fixed-wing-scenario-generator" },
        "profile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version"],
          "properties": {
            "id": { "const": "generic-fixed-wing" },
            "version": { "const": "1.0.0" }
          }
        }
      }
    },
    "scenarioReproduction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenarioId", "seed", "sampleCount", "cadenceMs", "startedAt"],
      "properties": {
        "scenarioId": { "$ref": "#/$defs/scenarioId" },
        "seed": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "sampleCount": { "type": "integer", "minimum": 60, "maximum": 2000 },
        "cadenceMs": { "const": 1000 },
        "startedAt": { "type": "string", "format": "date-time" }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["faultId", "onsetIndex", "activeEndIndex", "recoveryEndIndex"],
      "properties": {
        "faultId": { "$ref": "#/$defs/faultId" },
        "onsetIndex": { "type": "integer", "minimum": 0, "maximum": 1999 },
        "activeEndIndex": { "type": "integer", "minimum": 0, "maximum": 1999 },
        "recoveryEndIndex": { "type": "integer", "minimum": 0, "maximum": 1999 }
      }
    },
    "verificationState": { "enum": ["pending", "verified", "mismatch", "unavailable"] },
    "qualityGateState": { "enum": ["pending", "passed", "failed", "unavailable"] },
    "modelReason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "detail", "channels"],
      "properties": {
        "code": { "type": "string", "minLength": 1, "maxLength": 128 },
        "detail": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "channels": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 64 }
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "active": { "const": true } }, "required": ["active"] },
          "then": {
            "properties": {
              "activationPurpose": { "const": "integrated-advisory" },
              "userSelection": { "const": "enabled" },
              "supported": { "const": true },
              "eligible": { "const": true },
              "identityVerification": {
                "type": "object",
                "properties": {
                  "artifact": { "const": "verified" },
                  "configuration": { "const": "verified" }
                }
              },
              "qualityGate": {
                "type": "object",
                "properties": { "state": { "const": "passed" } }
              }
            }
          }
        },
        {
          "if": { "properties": { "eligible": { "const": true } }, "required": ["eligible"] },
          "then": {
            "properties": {
              "activationPurpose": { "const": "integrated-advisory" },
              "supported": { "const": true }
            }
          }
        },
        {
          "if": {
            "properties": { "activationPurpose": { "const": "research-evidence-only" } },
            "required": ["activationPurpose"]
          },
          "then": {
            "properties": { "eligible": { "const": false }, "active": { "const": false } }
          }
        }
      ],
      "required": [
        "key",
        "context",
        "activationPurpose",
        "userSelection",
        "expectedIdentities",
        "observedIdentities",
        "identityVerification",
        "qualityGate",
        "supported",
        "eligible",
        "active",
        "authority",
        "reasons"
      ],
      "properties": {
        "key": { "type": "string", "minLength": 3, "maxLength": 160 },
        "context": { "$ref": "#/$defs/boundedText" },
        "activationPurpose": { "enum": ["integrated-advisory", "research-evidence-only"] },
        "userSelection": { "enum": ["enabled", "disabled"] },
        "expectedIdentities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifactSha256", "configurationSha256"],
          "properties": {
            "artifactSha256": { "$ref": "#/$defs/sha256" },
            "configurationSha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "observedIdentities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifactSha256", "configurationSha256"],
          "properties": {
            "artifactSha256": { "$ref": "#/$defs/sha256" },
            "configurationSha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "identityVerification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact", "configuration"],
          "properties": {
            "artifact": { "$ref": "#/$defs/verificationState" },
            "configuration": { "$ref": "#/$defs/verificationState" }
          }
        },
        "qualityGate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "storedPassed", "recomputedPassed"],
          "properties": {
            "state": { "$ref": "#/$defs/qualityGateState" },
            "storedPassed": { "type": ["boolean", "null"] },
            "recomputedPassed": { "type": ["boolean", "null"] }
          }
        },
        "supported": { "type": "boolean" },
        "eligible": { "type": "boolean" },
        "active": { "type": "boolean" },
        "authority": { "const": "deterministic-rules" },
        "reasons": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/modelReason" }
        }
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "required": ["temporalModel", "robustCovariance"],
      "properties": {
        "temporalModel": { "$ref": "#/$defs/model" },
        "robustCovariance": { "$ref": "#/$defs/model" }
      }
    },
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deterministicIndex",
        "deterministicDelaySamples",
        "deterministicDelayMs",
        "modelIndex",
        "modelDelaySamples",
        "modelDelayMs"
      ],
      "properties": {
        "deterministicIndex": { "$ref": "#/$defs/sampleIndex" },
        "deterministicDelaySamples": { "$ref": "#/$defs/sampleIndex" },
        "deterministicDelayMs": { "$ref": "#/$defs/delayMs" },
        "modelIndex": { "$ref": "#/$defs/sampleIndex" },
        "modelDelaySamples": { "$ref": "#/$defs/sampleIndex" },
        "modelDelayMs": { "$ref": "#/$defs/delayMs" }
      }
    },
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hypothesisType", "indicationCount", "firstIndicationIndex", "score"],
      "properties": {
        "hypothesisType": {
          "enum": [
            "gradual-drift",
            "noise-growth",
            "oscillation",
            "sensor-lag",
            "intermittent-dropout",
            "stuck-value",
            "gain-error",
            "fuel-leak",
            "cross-sensor-decoupling",
            "simultaneous-faults"
          ]
        },
        "indicationCount": { "$ref": "#/$defs/count" },
        "firstIndicationIndex": { "$ref": "#/$defs/sampleIndex" },
        "score": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "decisionCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["indicate", "nominal", "unavailable"],
      "properties": {
        "indicate": { "type": "integer", "minimum": 0, "maximum": 2000 },
        "nominal": { "type": "integer", "minimum": 0, "maximum": 2000 },
        "unavailable": { "type": "integer", "minimum": 0, "maximum": 2000 }
      }
    },
    "detectorAggregates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluatedCount", "completeCount", "agreement", "decisions"],
      "properties": {
        "evaluatedCount": { "type": "integer", "minimum": 60, "maximum": 2000 },
        "completeCount": { "type": "integer", "minimum": 0, "maximum": 2000 },
        "agreement": {
          "type": "object",
          "additionalProperties": false,
          "required": ["unanimousIndicate", "unanimousNominal", "mixed"],
          "properties": {
            "unanimousIndicate": { "type": "integer", "minimum": 0, "maximum": 2000 },
            "unanimousNominal": { "type": "integer", "minimum": 0, "maximum": 2000 },
            "mixed": { "type": "integer", "minimum": 0, "maximum": 2000 }
          }
        },
        "decisions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "deterministicRules",
            "covarianceAdvisory",
            "kalmanInnovation",
            "temporalAdvisory"
          ],
          "properties": {
            "deterministicRules": { "$ref": "#/$defs/decisionCounts" },
            "covarianceAdvisory": { "$ref": "#/$defs/decisionCounts" },
            "kalmanInnovation": { "$ref": "#/$defs/decisionCounts" },
            "temporalAdvisory": { "$ref": "#/$defs/decisionCounts" }
          }
        }
      }
    },
    "results": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "phaseTransitionCount",
        "indicationCount",
        "distinctRuleIds",
        "detection",
        "rankedHypotheses",
        "detectorAggregates"
      ],
      "properties": {
        "authority": { "const": "deterministic-rules" },
        "phaseTransitionCount": { "$ref": "#/$defs/count" },
        "indicationCount": { "$ref": "#/$defs/count" },
        "distinctRuleIds": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "detection": { "$ref": "#/$defs/detection" },
        "rankedHypotheses": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": { "$ref": "#/$defs/hypothesis" }
        },
        "detectorAggregates": { "$ref": "#/$defs/detectorAggregates" }
      }
    },
    "exportPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceDataIncluded",
        "samplesIncluded",
        "pointsIncluded",
        "seriesIncluded",
        "measurementsIncluded",
        "truthIncluded",
        "perSampleLabelsIncluded",
        "browserStateIncluded",
        "endpointsIncluded"
      ],
      "properties": {
        "sourceDataIncluded": { "const": false },
        "samplesIncluded": { "const": false },
        "pointsIncluded": { "const": false },
        "seriesIncluded": { "const": false },
        "measurementsIncluded": { "const": false },
        "truthIncluded": { "const": false },
        "perSampleLabelsIncluded": { "const": false },
        "browserStateIncluded": { "const": false },
        "endpointsIncluded": { "const": false }
      }
    }
  }
}
