{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kato-mt.github.io/Aviation-Dashboard-Project/schemas/live-stream-v1.schema.json",
  "title": "Live Airspace WebSocket Message v1",
  "oneOf": [
    { "$ref": "#/$defs/hello" },
    { "$ref": "#/$defs/snapshot" },
    { "$ref": "#/$defs/health" },
    { "$ref": "#/$defs/error" }
  ],
  "$defs": {
    "envelope": {
      "type": "object",
      "required": ["type", "protocolVersion"],
      "properties": {
        "protocolVersion": { "const": "1.0.0" }
      }
    },
    "hello": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "protocolVersion",
            "schemaVersion",
            "regionId",
            "providerId",
            "pollIntervalMs",
            "generatedAt"
          ],
          "properties": {
            "type": { "const": "hello" },
            "protocolVersion": { "const": "1.0.0" },
            "schemaVersion": { "const": "airspace.v1" },
            "regionId": { "type": "string", "minLength": 1 },
            "providerId": { "type": "string", "minLength": 1 },
            "pollIntervalMs": { "type": "integer", "minimum": 1000 },
            "generatedAt": { "type": "string", "format": "date-time" }
          }
        }
      ]
    },
    "snapshot": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "protocolVersion", "snapshot"],
          "properties": {
            "type": { "const": "airspace.snapshot" },
            "protocolVersion": { "const": "1.0.0" },
            "snapshot": { "$ref": "airspace-v1.schema.json" }
          }
        }
      ]
    },
    "health": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "protocolVersion", "health"],
          "properties": {
            "type": { "const": "feed.health" },
            "protocolVersion": { "const": "1.0.0" },
            "health": {
              "type": "object",
              "required": [
                "schemaVersion",
                "regionId",
                "providerId",
                "status",
                "checkedAt",
                "consecutiveFailures",
                "message"
              ]
            }
          }
        }
      ]
    },
    "error": {
      "allOf": [
        { "$ref": "#/$defs/envelope" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "protocolVersion", "code", "message", "recoverable"],
          "properties": {
            "type": { "const": "error" },
            "protocolVersion": { "const": "1.0.0" },
            "code": {
              "enum": [
                "REGION_NOT_FOUND",
                "UPSTREAM_UNAVAILABLE",
                "PROTOCOL_ERROR",
                "INTERNAL_ERROR"
              ]
            },
            "message": { "type": "string", "minLength": 1 },
            "recoverable": { "type": "boolean" },
            "retryAt": { "type": "string", "format": "date-time" }
          }
        }
      ]
    }
  }
}
