{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kato-mt.github.io/Aviation-Dashboard-Project/schemas/telemetry.v1.schema.json",
  "title": "Synthetic Canonical Telemetry Run",
  "type": "object",
  "required": ["schemaVersion", "runId", "sources", "samples"],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": { "const": "telemetry.v1" },
    "runId": { "type": "string", "minLength": 1 },
    "title": { "type": "string" },
    "profile": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sourceId", "units"],
        "properties": {
          "sourceId": { "type": "string", "minLength": 1 },
          "label": { "type": "string" },
          "units": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": true
      }
    },
    "samples": {
      "type": "array",
      "maxItems": 250000,
      "items": {
        "type": "object",
        "required": ["sourceId", "timestamp", "measurements"],
        "properties": {
          "sourceId": { "type": "string", "minLength": 1 },
          "sequence": { "type": "integer", "minimum": 0 },
          "timestamp": { "type": "string", "format": "date-time" },
          "measurements": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": { "type": "number" }
          },
          "units": {
            "type": "object",
            "additionalProperties": { "type": "string", "minLength": 1 }
          },
          "qualityFlags": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": ["valid", "estimated", "injected", "suspect", "stale", "quarantined"]
            }
          }
        },
        "additionalProperties": true
      }
    }
  }
}
