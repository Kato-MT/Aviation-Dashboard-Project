{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "flight-diagnostics-workbench-v3",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-27",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "REGION_FEEDS",
        "class_name": "RegionalFeedHub",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RegionalFeedHub"],
    },
  ],
  "vars": {
    "LIVE_PROVIDER_BASE_URL": "https://api.adsb.lol",
    "ALLOWED_ORIGINS": "http://127.0.0.1:4173,http://localhost:4173",
    "APP_VERSION": "3.0.0-dev",
    "RELEASE_SHA": "local",
  },
  "limits": {
    "cpu_ms": 1000,
    "subrequests": 10,
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
}
