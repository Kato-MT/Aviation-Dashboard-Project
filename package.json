{
  "name": "flight-diagnostics-workbench",
  "version": "2.2.0",
  "private": true,
  "description": "A synthetic telemetry integration, diagnostics, and verification workbench.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "vite",
    "dev:live": "vite --config vite.live.config.ts",
    "build:live": "tsx tools/live/buildConnectedArtifact.ts production",
    "build:mock-staging": "tsx tools/live/buildConnectedArtifact.ts mock-staging",
    "verify:live-builds": "tsx tools/live/verifyBuilds.ts",
    "browser:budgets": "tsx tools/live/verifyBrowserBudgets.ts",
    "privacy:verify": "pnpm verify:live-builds && vitest run tests/live/operations-privacy.test.ts tests/live/g2-evidence-policy.test.ts tests/live/retain-candidate.test.ts && pnpm test:g2-firebreak",
    "runbooks:verify": "tsx tools/live/verifyRunbooks.ts",
    "runbooks:rehearse": "tsx tools/live/rehearseRunbooks.ts",
    "runbooks:rehearse:candidate": "tsx tools/live/rehearseCandidateRunbooks.ts",
    "worker:dry-run": "pnpm verify:live-builds && wrangler deploy --dry-run --config dist-live/airspace_worker/wrangler.json --outdir .tmp-tests/worker-dry-run",
    "candidate:retain": "tsx tools/live/retainCandidate.ts",
    "candidate:verify": "tsx tools/live/verifyCandidate.ts",
    "candidate:serve": "tsx tools/live/serveCandidate.ts",
    "candidate:acceptance": "tsx tools/live/recordCandidateAcceptance.ts",
    "live:capacity": "tsx tools/live/capacity.ts",
    "live:load:smoke": "tsx tools/live/loadHarness.ts --artifact-root dist-mock-staging --profile smoke --output test-results/live-load/smoke.json",
    "live:load:maximum": "tsx tools/live/loadHarness.ts --artifact-root dist-mock-staging --profile maximum --output test-results/live-load/maximum.json",
    "live:load:soak": "tsx tools/live/loadHarness.ts --artifact-root dist-mock-staging --profile soak --output test-results/live-load/soak.json",
    "live:load:candidate:smoke": "tsx tools/live/loadHarness.ts --profile smoke --output test-results/live-load/candidate-smoke.json",
    "maps:prepare": "tsx tools/maps/prepare.ts",
    "maps:manifest": "tsx tools/maps/manifest.ts",
    "maps:seed": "tsx tools/maps/seed.ts",
    "test:live-browser": "playwright test --config playwright.live.config.ts",
    "test:g2-firebreak": "tsx tools/live/runG2Firebreak.ts",
    "test:live-flow": "playwright test --config playwright.live-flow.config.ts",
    "test:m3-walkthrough": "playwright test --config playwright.m3.config.ts",
    "test:m34-artifact": "playwright test --config playwright.m34.config.ts",
    "test:browser-performance": "tsx tools/live/runBrowserPerformance.ts",
    "test:visual-regression": "playwright test --config playwright.visual.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tests/worker/tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:python": "python -m unittest discover -s tests/analytics -p \"test_*.py\" && python -m unittest discover -s tests/ml -p \"test_*.py\"",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/accessibility",
    "mutation": "stryker run",
    "build": "pnpm typecheck && vite build",
    "build:offline": "pnpm typecheck && vite build --config vite.offline.config.ts",
    "preview": "vite preview",
    "simulator": "tsx simulator/server.ts",
    "benchmark": "tsx tools/benchmarks/run.ts",
    "benchmark:temporal": "tsx tools/benchmarks/temporal.ts",
    "analytics": "python tools/analytics/analytics.py report --output analytics/latest-report.md",
    "analytics:campaign": "python tools/analytics/temporal_campaign.py report",
    "campaign:report": "tsx tools/release/generate-temporal-campaign-report.ts",
    "ml:train": "python tools/ml/train.py && python tools/ml/train_temporal_model.py && python tools/ml/train_temporal_integration_model.py",
    "requirements:traceability": "node scripts/release/verify-traceability.mjs --require-evidence-paths",
    "r3:evidence:refresh": "tsx tools/live/selectedR3EvidenceCli.ts refresh",
    "r3:evidence:check": "tsx tools/live/selectedR3EvidenceCli.ts check",
    "test:r3-evidence": "vitest run tests/live/selected-r3-evidence.test.ts",
    "requirements:check": "pnpm requirements:traceability && pnpm r3:evidence:check",
    "release:report": "tsx tools/release/generate-verification-report.ts",
    "release:assemble": "node scripts/release/assemble-release.mjs",
    "release:verify": "node scripts/release/verify-release.mjs",
    "screenshots": "tsx tools/release/capture-screenshots.ts",
    "sbom:generate": "pnpm sbom --sbom-format cyclonedx --lockfile-only --out dist/sbom.cdx.json",
    "checksums": "node scripts/release/generate-checksums.mjs dist",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm test:worker && pnpm test:python && pnpm requirements:check && pnpm build && pnpm build:offline"
  },
  "dependencies": {
    "@fontsource/inter": "5.2.8",
    "@fontsource/jetbrains-mono": "5.2.8",
    "chart.js": "4.5.1",
    "maplibre-gl": "6.6.0",
    "papaparse": "5.5.4",
    "pmtiles": "4.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@cloudflare/vite-plugin": "1.54.0",
    "@cloudflare/vitest-plugin": "1.1.0",
    "@cloudflare/workers-types": "5.20260827.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.0",
    "@protomaps/basemaps": "5.7.2",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/typescript-checker": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@types/node": "26.1.2",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "4.1.10",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "es-module-lexer": "2.3.1",
    "eslint": "10.8.0",
    "fast-check": "4.9.0",
    "fflate": "0.8.3",
    "jsdom": "30.0.1",
    "miniflare": "5.20260825.0-alpha",
    "parse5": "8.0.1",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "4.1.10",
    "wrangler": "4.126.0"
  }
}
