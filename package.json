{
  "name": "flight-diagnostics-workbench",
  "version": "2.2.0",
  "private": true,
  "description": "A synthetic telemetry integration, diagnostics, and verification workbench.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:python": "python -m unittest discover -s tests/analytics -p \"test_*.py\" && python -m unittest discover -s tests/ml -p \"test_*.py\"",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/accessibility",
    "mutation": "stryker run",
    "build": "pnpm typecheck && vite build",
    "build:offline": "pnpm typecheck && vite build --config vite.offline.config.ts",
    "preview": "vite preview",
    "simulator": "tsx simulator/server.ts",
    "benchmark": "tsx tools/benchmarks/run.ts",
    "benchmark:temporal": "tsx tools/benchmarks/temporal.ts",
    "analytics": "python tools/analytics/analytics.py report --output analytics/latest-report.md",
    "analytics:campaign": "python tools/analytics/temporal_campaign.py report",
    "campaign:report": "tsx tools/release/generate-temporal-campaign-report.ts",
    "ml:train": "python tools/ml/train.py && python tools/ml/train_temporal_model.py && python tools/ml/train_temporal_integration_model.py",
    "requirements:check": "node scripts/release/verify-traceability.mjs",
    "release:report": "tsx tools/release/generate-verification-report.ts",
    "release:assemble": "node scripts/release/assemble-release.mjs",
    "release:verify": "node scripts/release/verify-release.mjs",
    "screenshots": "tsx tools/release/capture-screenshots.ts",
    "sbom:generate": "pnpm sbom --sbom-format cyclonedx --lockfile-only --out dist/sbom.cdx.json",
    "checksums": "node scripts/release/generate-checksums.mjs dist",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm test:python && pnpm requirements:check && pnpm build && pnpm build:offline"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "chart.js": "4.5.1",
    "papaparse": "5.5.4",
    "ws": "8.21.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.0",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/typescript-checker": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@types/node": "26.1.2",
    "@types/papaparse": "5.5.2",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "fast-check": "4.9.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "4.1.10"
  }
}
